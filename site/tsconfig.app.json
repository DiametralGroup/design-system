{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@registry/*": ["./src/registry/*"]
    }
  },
  "include": ["src"],
  /* Demos for components no batch has landed yet. They import specifiers that
     do not resolve here on purpose — the batch that lands a slug moves its
     directory up into registry/demos/ and it starts being checked. Kept out of
     the glob in demos.ts by the same directory boundary. */
  "exclude": ["src/registry/_pending"]
}
