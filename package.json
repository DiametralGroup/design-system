{
  "name": "@diametral/design-system",
  "version": "5.0.0-beta",
  "description": "Diametral Design System — a minimal, flat, buildless CSS + tokens + Web Components design system. Welcome to (the real).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "web-components",
    "diametral"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleBigCode/design-system.git"
  },
  "homepage": "https://littlebigcode.github.io/design-system/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "./components/*.js",
    "./dist/components/*.js"
  ],
  "files": [
    "css",
    "components",
    "tokens",
    "dist",
    "docs",
    "configs",
    "emails",
    "keycloak",
    "assets/fonts/ufficio.css",
    "assets/fonts/fallback.css",
    "assets/fonts/LICENSE-FONTS.md",
    "assets/logo/diametral-mark.svg",
    "assets/logo/diametral-mark-light.svg",
    "assets/logo/favicon.svg",
    "assets/logo/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "style": "./css/diametral.css",
      "default": "./css/diametral.css"
    },
    "./css/diametral.css": "./css/diametral.css",
    "./css/*": "./css/*",
    "./tokens.json": "./tokens/tokens.json",
    "./components": "./components/index.js",
    "./components/*": "./components/*",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/components/*.d.ts",
      "default": "./dist/react/components/*.js"
    },
    "./configs/*": "./configs/*",
    "./emails": {
      "types": "./emails/diametral-email.d.ts",
      "default": "./emails/diametral-email.js"
    },
    "./tailwind-preset": "./dist/tailwind-preset.cjs",
    "./dist/*": "./dist/*",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "npm run build:react && node scripts/build-tokens.mjs && node scripts/build-css.mjs && node scripts/build-components.mjs && node scripts/build-figma.mjs && node scripts/build-migration-guide.mjs && node scripts/build-components-md.mjs && node scripts/build-agent-index.mjs && npm run build:docs",
    "build:react": "tsc -p tsconfig.build.json",
    "build:docs": "tsc -p tsconfig.docs.json",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:figma": "node scripts/build-figma.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:components": "node scripts/build-components.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && node scripts/check-contracts.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "build:components-md": "node scripts/build-components-md.mjs",
    "build:agent-index": "node scripts/build-agent-index.mjs",
    "codemod:1.0": "node scripts/codemod-1.0-renames.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "~5.7"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^8.21.3",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.8.0"
  }
}
